import { ServiceUnavailableException } from '@nestjs/common';
import type { Connection } from 'mongoose';
import { HealthController } from './health.controller';

describe('HealthController', () => {
  it('reports process health without touching the database', () => {
    const ping = jest.fn();
    const controller = new HealthController({
      db: { admin: () => ({ ping }) },
    } as unknown as Connection);

    expect(controller.checkProcess()).toEqual({ status: 'ok' });
    expect(ping).not.toHaveBeenCalled();
  });

  it('pings MongoDB for the database health check', async () => {
    const ping = jest.fn().mockResolvedValue({ ok: 1 });
    const controller = new HealthController({
      db: { admin: () => ({ ping }) },
    } as unknown as Connection);

    const result = await controller.checkDatabase();

    expect(result.status).toBe('ok');
    expect(result.database).toBe('mongodb');
    expect(typeof result.responseTimeMs).toBe('number');
    expect(ping).toHaveBeenCalledTimes(1);
  });

  it('returns unavailable when MongoDB cannot be reached', async () => {
    const ping = jest.fn().mockRejectedValue(new Error('offline'));
    const controller = new HealthController({
      db: { admin: () => ({ ping }) },
    } as unknown as Connection);

    await expect(controller.checkDatabase()).rejects.toBeInstanceOf(
      ServiceUnavailableException,
    );
  });
});
